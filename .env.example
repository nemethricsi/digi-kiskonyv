NEXT_PUBLIC_SERVER_URL=http://localhost:3000

DATABASE_URL=postgres://payload:payload@localhost:5432/digi-kiskonyv
# min. 32 chars: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Mailpit (docker compose), web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Seed (pnpm seed), validated in src/seed/env.ts: passwords min. 8 chars (admin@example.com, clerk@example.com)
SEED_ADMIN_PASSWORD=change-me
SEED_CLERK_PASSWORD=change-me-too

# Admin dashboard "reset demo data" button (truncate + seed). Production too, if set to true.
ALLOW_DEMO_RESET=true
