{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [
      {
        "groupName": "react-next",
        "elementNamePattern": ["react", "react-**", "next", "next/**"]
      }
    ],
    "groups": [
      "react-next",
      ["value-builtin", "value-external"],
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "type-import",
      "unknown"
    ]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    ".claude/skills/**",
    "src/payload-types.ts",
    "src/app/(payload)/**",
    "src/migrations/**"
  ]
}
